# ---------------------------------------------------------------------------
# Pragati Auto - environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# REQUIRED - PostgreSQL connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI (use the
#           "Session"/pooler URI for serverless; add ?pgbouncer=true&connection_limit=1)
# Neon:     Dashboard -> Connection Details -> Prisma
# Local:    docker compose up -d   (then use the value below as-is)
DATABASE_URL="postgresql://garage:garage@localhost:5432/garage?schema=public"

# REQUIRED - direct (non-pooled) connection used by `prisma migrate` / `db push`.
# On Neon/Supabase: DATABASE_URL = the POOLED url, DIRECT_URL = the DIRECT url.
# Locally: set it to the SAME value as DATABASE_URL (as shown below).
DIRECT_URL="postgresql://garage:garage@localhost:5432/garage?schema=public"

# REQUIRED - secret used to sign session JWTs and password-reset tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# REQUIRED in production - the public origin of the deployed app.
# Used to build the public invoice links shared over WhatsApp and in reset emails.
# On Vercel this is auto-detected from VERCEL_URL if left unset, but setting it
# explicitly (to your custom domain) is strongly recommended.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OPTIONAL - Supabase Storage (garage logo + hosted invoice PDFs)
# Without these the app stores the logo in the database as a data URL and serves
# invoice PDFs from its own /api route, so everything still works out of the box.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# SUPABASE_STORAGE_BUCKET="garage"

# ---------------------------------------------------------------------------
# OPTIONAL - transactional email for "Forgot password"
# When unset, the reset link is written to the server console (and returned in
# the API response while NODE_ENV !== 'production') so the flow is testable.
# ---------------------------------------------------------------------------
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Garage Management <noreply@yourgarage.com>"

# ---------------------------------------------------------------------------
# OPTIONAL - WhatsApp Cloud API (direct PDF delivery).
# When unset the app uses the free wa.me click-to-chat deep link, which always
# works with zero paid setup.
# ---------------------------------------------------------------------------
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# Owner account (used by `npm run db:seed`)
# ---------------------------------------------------------------------------
# Single owner (admin) login created by `npm run db:seed`. Email and password
# are required - seeding fails without them. Never commit the real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Owner"
