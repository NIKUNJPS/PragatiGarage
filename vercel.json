{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/invoices/[id]/pdf/route.ts": { "maxDuration": 30 },
    "src/app/api/invoices/[id]/share/route.ts": { "maxDuration": 30 },
    "src/app/i/[token]/pdf/route.ts": { "maxDuration": 30 }
  }
}
